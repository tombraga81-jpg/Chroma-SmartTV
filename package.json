{
  "name": "chroma-smart-tv",
  "private": true,
  "version": "1.3.0",
  "description": "Chroma Smart TV — Player IPTV M3U & Xtream para Samsung Tizen TV",
  "type": "module",
  "packageType": "app",
  "appName": "Chroma Smart TV",
  "appPath": "dist/index.html",
  "main": "dist/index.html",
  "evaluateScriptOnDocumentStart": false,
  "keys": [
    "MediaPlay",
    "MediaPause",
    "MediaPlayPause",
    "MediaStop",
    "MediaFastForward",
    "MediaRewind",
    "ChannelUp",
    "ChannelDown",
    "ColorF0Red",
    "ColorF1Green",
    "ColorF2Yellow",
    "ColorF3Blue"
  ],
  "files": [
    "dist",
    "config.xml",
    "icon.png",
    "ChromaSmartTV.wgt"
  ],
  "scripts": {
    "dev": "tsx server.ts",
    "start": "NODE_ENV=production tsx server.ts",
    "build": "vite build",
    "build:tizen": "vite build",
    "build:wgt": "vite build && node scripts/build-wgt.mjs",
    "package:wgt": "vite build && tizen package -t wgt -- dist",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js ChromaSmartTV.wgt",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "hls.js": "^1.7.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21"
  }
}
